@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Console</title>

    <!-- Google Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/E_commerceInASP.NET.styles.css" asp-append-version="true" />

    <style>
            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: #f8fafc;
                margin-bottom: 0 !important;
            }

            .admin-topbar {
                background: #ffffff;
                border-bottom: 1px solid #e2e8f0;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- MINIMAL ADMIN TOP BAR -->
    <header class="admin-topbar sticky-top py-2 px-4">
        <div class="d-flex justify-content-between align-items-center">

            <!-- Brand / Indicator -->
            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Admin" asp-action="Index" class="text-decoration-none text-dark fw-bold fs-5 d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-primary"></i>
                    <span>Store Admin</span>
                </a>
                <span class="badge bg-secondary-subtle text-secondary border small">Management Portal</span>
            </div>

            <!-- Right Controls: View Live Site & Sign Out -->
            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Customer" asp-action="Index" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Live Store
                </a>

                <a asp-controller="Admin" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                </a>
            </div>

        </div>
    </header>

    <!-- MAIN ADMIN BODY CONTENT -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- MINIMAL ADMIN FOOTER BAR -->
    <footer class="py-3 bg-white border-top text-center text-muted small mt-auto">
        &copy; @DateTime.Now.Year Mobile Store Operations — Authorized Personnel Only
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>