@using Microsoft.AspNetCore.Http
@using System.Linq
@inject E_commerceInASP.NET.Models.MyContext dbContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce Store</title>

    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/E_commerceInASP.NET.styles.css" asp-append-version="true" />

    <style>
            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: #f8f9fa;
            }

            .navbar-brand {
                font-weight: 700;
                letter-spacing: -0.5px;
            }

            .nav-link {
                font-weight: 500;
                font-size: 0.95rem;
                transition: color 0.2s ease;
            }

                .nav-link:hover {
                    color: #0d6efd !important;
                }

            .footer-link {
                color: #adb5bd;
                text-decoration: none;
                transition: color 0.2s ease;
                font-size: 0.9rem;
            }

                .footer-link:hover {
                    color: #fff;
                }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- TOP PROMO ANNOUNCEMENT BAR -->
    <div class="bg-dark text-white text-center py-2 small fw-semibold">
        🚚 Free standard shipping on orders over Rs. 2,000 | Cash on Delivery available
    </div>

    <!-- MAIN STORE NAVIGATION -->
    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">
                <!-- Store Logo -->
                <a class="navbar-brand fs-4 text-dark d-flex align-items-center gap-2" asp-controller="Customer" asp-action="Index">
                    <i class="bi bi-bag-check-fill text-primary"></i>
                    <span>Mobile Store</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse" id="navbarMain">
                    <!-- Left: Primary Store Links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link text-secondary" asp-controller="Customer" asp-action="Index">Home</a>
                        </li>

                        <!-- Category Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-secondary" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Categories
                            </a>
                            <ul class="dropdown-menu border-0 shadow-sm rounded-3 py-2">
                                @{
                                    var categoryList = dbContext.tbl_category.ToList();
                                }
                                @if (categoryList.Any())
                                {
                                    foreach (var cat in categoryList)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Customer" asp-action="productDetails" asp-route-id="@cat.Category_id">
                                                @cat.Category_Name
                                            </a>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li><span class="dropdown-item-text text-muted small">No categories found</span></li>
                                }
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-secondary" asp-controller="Customer" asp-action="Feedback">Contact & Feedback</a>
                        </li>
                    </ul>

                    <!-- Right: Search, Admin Portal, Customer Actions -->
                    <div class="d-flex align-items-center gap-3">
                        <!-- Quick Link to Admin Panel -->
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                            <i class="bi bi-shield-lock me-1"></i> Admin
                        </a>

                        @if (string.IsNullOrEmpty(Context.Session.GetString("customerSession")))
                        {
                            <!-- Guest State -->
                            <a asp-controller="Customer" asp-action="customerLogin" class="btn btn-dark btn-sm px-4 rounded-pill fw-semibold">
                                <i class="bi bi-person me-1"></i> Sign In
                            </a>
                        }
                        else
                        {
                            <!-- Authenticated Customer Menu -->
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm border dropdown-toggle px-3 rounded-pill fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1 text-primary"></i> Account
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm rounded-3 mt-2">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Customer" asp-action="customerProfile">
                                            <i class="bi bi-person me-2 text-muted"></i> My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Customer" asp-action="viewCart">
                                            <i class="bi bi-bag me-2 text-muted"></i> My Cart
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger" asp-controller="Customer" asp-action="customerLogout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- Cart Button with Icon -->
                            <a asp-controller="Customer" asp-action="viewCart" class="btn btn-light border position-relative rounded-pill px-3 py-1" title="View Cart">
                                <i class="bi bi-cart3 fs-6"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN BODY CONTENT -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- STORE FOOTER -->
    <footer class="bg-dark text-light pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Col 1: Store Bio -->
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-bag-check-fill text-primary"></i> Mobile Store
                    </h5>
                    <p class="text-secondary small mb-3">
                        Your trusted shopping destination for quality electronics, gadgets, and everyday essentials. Safe payment and prompt home deliveries.
                    </p>
                    <div class="d-flex gap-3 text-secondary">
                        <a href="#" class="footer-link fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="footer-link fs-5"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="footer-link fs-5"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="footer-link fs-5"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>

                <!-- Col 2: Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-uppercase text-white small mb-3">Shop</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Customer" asp-action="Index" class="footer-link">Home</a></li>
                        <li><a asp-controller="Customer" asp-action="viewCart" class="footer-link">Shopping Cart</a></li>
                        <li><a asp-controller="Customer" asp-action="checkout" class="footer-link">Checkout</a></li>
                        <li><a asp-controller="Customer" asp-action="Feedback" class="footer-link">Customer Support</a></li>
                    </ul>
                </div>

                <!-- Col 3: Customer Care -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-uppercase text-white small mb-3">Customer Service</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy Policy</a></li>
                        <li><a href="#" class="footer-link">Terms & Conditions</a></li>
                        <li><a href="#" class="footer-link">Shipping & Delivery</a></li>
                        <li><a href="#" class="footer-link">Return & Refund Policy</a></li>
                    </ul>
                </div>

                <!-- Col 4: Contact & Hours -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-uppercase text-white small mb-3">Get in Touch</h6>
                    <ul class="list-unstyled small text-secondary d-flex flex-column gap-2 mb-0">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt text-primary"></i> Sargodha, Punjab, Pakistan
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone text-primary"></i> +92 300 0000000
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope text-primary"></i> support@mobilestore.com
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock text-primary"></i> Mon – Sat: 9:00 AM – 8:00 PM
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Bottom Sub-Footer -->
            <div class="border-top border-secondary pt-3 mt-4 d-flex flex-column flex-sm-row justify-content-between align-items-center small text-secondary">
                <p class="mb-0">&copy; @DateTime.Now.Year MobileStore. All rights reserved.</p>
                <div class="d-flex gap-3 mt-2 mt-sm-0">
                    <span>Payment Methods: <strong>COD (Cash on Delivery)</strong></span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>