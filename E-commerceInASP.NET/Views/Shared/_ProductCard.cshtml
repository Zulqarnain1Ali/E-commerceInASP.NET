@model E_commerceInASP.NET.Models.Product

<div class="col-12 col-sm-6 col-md-4 col-lg-3">
    <div class="card h-100 shadow-sm border-0 position-relative">
        
        @if (Model.Category != null && !string.IsNullOrEmpty(Model.Category.Category_Name))
        {
            <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 z-1">
                @Model.Category.Category_Name
            </span>
        }

        <div class="ratio ratio-4x3 bg-light rounded-top overflow-hidden">
            @if (!string.IsNullOrEmpty(Model.Product_Image))
            {
                <img src="@Model.Product_Image" 
                     class="card-img-top object-fit-cover" 
                     alt="@Model.Product_Name" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center text-muted">
                    No Image Available
                </div>
            }
        </div>

        <div class="card-body d-flex flex-column">
            <h6 class="card-title fw-bold text-truncate mb-1" title="@Model.Product_Name">
                @Model.Product_Name
            </h6>
            <p class="text-muted small text-truncate mb-3">
                @Model.Product_Description
            </p>
            
            <div class="mt-auto pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-dark fs-5">
                        Rs. @Model.Product_Price
                    </span>
                    <a asp-controller="Customer" 
                       asp-action="productDetails" 
                       asp-route-id="@Model.product_id" 
                       class="text-decoration-none small text-muted">
                        Details &rarr;
                    </a>
                </div>

                <button type="button" 
                        class="btn btn-sm btn-dark w-100 d-flex align-items-center justify-content-center gap-2 cart-btn"
                        data-prod-id="@Model.product_id">
                    <span class="btn-icon">🛒</span>
                    <span class="btn-text">Add to Cart</span>
                </button>
            </div>
        </div>

    </div>
</div>