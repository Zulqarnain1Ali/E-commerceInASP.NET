@model E_commerceInASP.NET.Models.Feedback
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Customer Feedback";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-1 fw-bold">We Value Your Feedback</h4>
                    <p class="text-white-50 small mb-0">Help us improve your shopping experience</p>
                </div>

                <div class="card-body p-4">
                    <!-- Success Banner -->
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
                            <strong>Thank you!</strong> @ViewBag.Success
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Error Banner -->
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                            <strong>Notice:</strong> @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Customer" asp-action="feedback" method="post">
                        
                        <!-- Name Field -->
                        <div class="mb-3">
                            <label asp-for="user_name" class="form-label fw-bold">Your Name</label>
                            <input asp-for="user_name" 
                                   class="form-control" 
                                   placeholder="Enter your name" 
                                   required />
                        </div>

                        <!-- Feedback Message -->
                        <div class="mb-3">
                            <label asp-for="user_message" class="form-label fw-bold">Your Thoughts / Feedback</label>
                            <textarea asp-for="user_message" 
                                      class="form-control" 
                                      rows="5" 
                                      placeholder="Tell us what you liked or what we could improve..." 
                                      required></textarea>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-dark btn-lg">
                                Submit Feedback
                            </button>
                        </div>

                        <!-- Back to Store Link -->
                        <div class="text-center mt-3">
                            <a asp-controller="Customer" asp-action="Index" class="text-decoration-none text-muted small">
                                &larr; Return to Store
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>