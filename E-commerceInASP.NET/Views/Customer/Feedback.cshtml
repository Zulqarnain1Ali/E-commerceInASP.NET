@model E_commerceInASP.NET.Models.Feedback

@{
    ViewData["Title"] = "Contact & Feedback";
}

<div class="container my-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">Get In Touch</h2>
        <p class="text-muted">Have a question or want to share feedback? We'd love to hear from you.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- LEFT COLUMN: Contact Details & Google Map -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-3">Contact Information</h5>
                        <p class="text-muted small mb-4">
                            Reach out to our customer care team or visit our storefront location.
                        </p>

                        <!-- Address -->
                        <div class="d-flex align-items-start mb-3">
                            <div class="badge bg-dark text-white p-2 rounded-circle me-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>
                                </svg>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Store Address</h6>
                                <small class="text-muted">Main Commercial Market, Sargodha, Pakistan</small>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="d-flex align-items-start mb-3">
                            <div class="badge bg-dark text-white p-2 rounded-circle me-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
                                </svg>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Email Support</h6>
                                <small class="text-muted">support@ecommercestore.com</small>
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="d-flex align-items-start mb-4">
                            <div class="badge bg-dark text-white p-2 rounded-circle me-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
                                </svg>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Call Us</h6>
                                <small class="text-muted">+92 (300) 123-4567</small>
                            </div>
                        </div>
                    </div>

                    <!-- Google Map Embed -->
                    <div class="rounded overflow-hidden border">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d108483.99824606708!2d72.60742187311746!3d32.08362947700037!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x392176b68516ee71%3A0x6b3061295f2a1b9e!2sSargodha%2C%20Punjab%2C%20Pakistan!5e0!3m2!1sen!2s!4v1700000000000!5m2!1sen!2s" 
                            width="100%" 
                            height="220" 
                            style="border:0;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Feedback Form -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-bold">Send Us a Message</h5>
                </div>

                <div class="card-body p-4">
                    <!-- Status alerts -->
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
                            <strong>Success:</strong> @ViewBag.Success
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                            <strong>Notice:</strong> @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Customer" asp-action="feedback" method="post">

                        <!-- Row for Name and Email -->
                        <div class="row">
                            <!-- Name Field -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="user_name" class="form-label fw-bold">Your Name</label>
                                <input asp-for="user_name"
                                       class="form-control"
                                       placeholder="Enter your name"
                                       required />
                            </div>

                            <!-- Email Field -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="user_email" class="form-label fw-bold">Your Email</label>
                                <input asp-for="user_email"
                                       type="email"
                                       class="form-control"
                                       placeholder="name@example.com"
                                       required />
                            </div>
                        </div>

                        <!-- Feedback Message -->
                        <div class="mb-4">
                            <label asp-for="user_message" class="form-label fw-bold">Your Message / Feedback</label>
                            <textarea asp-for="user_message"
                                      class="form-control"
                                      rows="7"
                                      placeholder="How can we assist you, or what would you like to share about our service?"
                                      required></textarea>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-dark btn-lg">
                                Send Message
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>