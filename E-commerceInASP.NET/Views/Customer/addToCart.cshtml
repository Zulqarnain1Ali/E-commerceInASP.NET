@model IEnumerable<E_commerceInASP.NET.Models.Cart>

@{
    ViewData["Title"] = "Shopping Cart";

    // Calculate subtotal from related product prices and quantities
    decimal subtotal = 0;
    if (Model != null)
    {
        subtotal = Model.Sum(c => Convert.ToDecimal(c.Product?.Product_Price ?? "0") * c.Product_Quantity);
    }
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Your Shopping Cart</h2>
            <p class="text-muted small mb-0">Manage your active cart items before proceeding.</p>
        </div>
        <span class="badge bg-dark px-3 py-2 fs-6">
            @(Model?.Count() ?? 0) Item(s)
        </span>
    </div>

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            @TempData["CartMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <div class="text-muted mb-3" style="font-size: 3rem;">🛒</div>
                <h4 class="fw-bold text-secondary">Your cart is empty</h4>
                <p class="text-muted small mb-4">You have no active items in your cart right now.</p>
                <a asp-controller="Customer" asp-action="allProducts" class="btn btn-dark px-4 py-2">
                    Browse Catalog &rarr;
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- CART ITEMS TABLE -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width: 70px;">#</th>
                                    <th style="width: 90px;">Item</th>
                                    <th>Product Title</th>
                                    <th>Price</th>
                                    <th style="width: 100px;">Qty</th>
                                    <th>Total</th>
                                    <th class="text-center" style="width: 80px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int counter = 1; }
                                @foreach (var item in Model)
                                {
                                    decimal unitPrice = Convert.ToDecimal(item.Product?.Product_Price ?? "0");
                                    decimal lineTotal = unitPrice * item.Product_Quantity;

                                    <tr>
                                        <td class="fw-bold text-muted">@counter</td>
                                        <td>
                                            <div class="ratio ratio-1x1 bg-light rounded overflow-hidden" style="width: 60px; height: 60px;">
                                                @if (!string.IsNullOrEmpty(item.Product?.Product_Image))
                                                {
                                                    <img src="@item.Product.Product_Image" class="object-fit-cover" alt="@item.Product.Product_Name" />
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center justify-content-center text-muted small">No Img</div>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <a asp-controller="Customer" 
                                               asp-action="productDetails" 
                                               asp-route-id="@item.Product_Id" 
                                               class="fw-bold text-dark text-decoration-none">
                                                @(item.Product?.Product_Name ?? "Unknown Product")
                                            </a>
                                        </td>
                                        <td class="text-muted">Rs. @unitPrice</td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                                                @item.Product_Quantity
                                            </span>
                                        </td>
                                        <td class="fw-bold text-dark">Rs. @lineTotal</td>
                                        <td class="text-center">
                                            <a asp-controller="Customer" 
                                               asp-action="removeFromCart" 
                                               asp-route-id="@item.id" 
                                               onclick="return confirm('Remove this item from your cart?');"
                                               class="btn btn-sm btn-outline-danger">
                                                ✕
                                            </a>
                                        </td>
                                    </tr>
                                    counter++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-controller="Customer" asp-action="allProducts" class="text-decoration-none text-muted small">
                        &larr; Continue Shopping
                    </a>
                </div>
            </div>

            <!-- ORDER SUMMARY -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-dark text-white py-3">
                        <h5 class="mb-0 fw-bold">Order Summary</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total Quantity</span>
                            <span class="fw-semibold">@Model.Sum(c => c.Product_Quantity)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-semibold">Rs. @subtotal</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Delivery Charges</span>
                            <span class="text-success fw-semibold">Free</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-bold">Grand Total</span>
                            <span class="fs-4 fw-bold text-dark">Rs. @subtotal</span>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="Customer" asp-action="checkout" class="btn btn-dark btn-lg">
                                Proceed to Checkout &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>