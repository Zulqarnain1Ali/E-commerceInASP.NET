@model E_commerceInASP.NET.Models.Customer

@{
    ViewData["Title"] = "Customer Profile";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold">Customer Profile</h5>
                    <span class="badge bg-light text-dark">ID: #@Model.Customer_id</span>
                </div>

                <div class="card-body p-4">
                    <div class="row align-items-center mb-4 pb-3 border-bottom">
                        <!-- Profile Image -->
                        <div class="col-md-4 text-center mb-3 mb-md-0">
                            @if (!string.IsNullOrEmpty(Model.Customer_Image))
                            {
                                <img src="~/images/customer/@Model.Customer_Image" 
                                     alt="@Model.Customer_Name" 
                                     class="rounded-circle img-thumbnail shadow-sm" 
                                     style="width: 140px; height: 140px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary text-white d-inline-flex justify-content-center align-items-center shadow-sm" 
                                     style="width: 140px; height: 140px; font-size: 3rem; font-weight: bold;">
                                    @(string.IsNullOrEmpty(Model.Customer_Name) ? "U" : Model.Customer_Name.Substring(0, 1).ToUpper())
                                </div>
                            }
                            <h5 class="mt-3 mb-0 fw-bold">@Model.Customer_Name</h5>
                            <small class="text-muted">@Model.Customer_Email</small>
                        </div>

                        <!-- Summary / Contact Quick View -->
                        <div class="col-md-8">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">Full Name</dt>
                                <dd class="col-sm-8 fw-semibold">@(Model.Customer_Name ?? "N/A")</dd>

                                <dt class="col-sm-4 text-muted">Email</dt>
                                <dd class="col-sm-8 fw-semibold">@(Model.Customer_Email ?? "N/A")</dd>

                                <dt class="col-sm-4 text-muted">Phone</dt>
                                <dd class="col-sm-8 fw-semibold">@(Model.Customer_Phone ?? "N/A")</dd>

                                <dt class="col-sm-4 text-muted">Gender</dt>
                                <dd class="col-sm-8 fw-semibold">@(Model.Customer_Gender ?? "N/A")</dd>
                            </dl>
                        </div>
                    </div>

                    <!-- Address & Location Details -->
                    <h6 class="text-uppercase text-muted fw-bold mb-3 small">Location & Shipping Address</h6>
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small mb-1">Country</label>
                            <div class="p-2 border rounded bg-light fw-semibold">
                                @(Model.Customer_Country ?? "Not specified")
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small mb-1">City</label>
                            <div class="p-2 border rounded bg-light fw-semibold">
                                @(Model.Customer_City ?? "Not specified")
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small mb-1">Street Address</label>
                            <div class="p-2 border rounded bg-light fw-semibold">
                                @(Model.Customer_Address ?? "Not specified")
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary">
                            &larr; Back to Shop
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-controller="Customer" asp-action="customerEdit" class="btn btn-outline">
                                Edit Profile
                            </a>
                            <a asp-controller="Customer" asp-action="customerLogout" class="btn btn-outline-danger">
                                Sign Out
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>