@model IEnumerable<E_commerceInASP.NET.Models.Product>

@{
    ViewData["Title"] = "All Products - Store Catalogue";
}

<div class="container my-5">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Customer" asp-action="Index" class="text-decoration-none text-muted">Home</a>
            </li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Catalog</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">Our Complete Catalog</h2>
            <p class="text-muted small mb-0">Browse through all available products and collections.</p>
        </div>
        <span class="badge bg-dark px-3 py-2 fs-6 mt-2 mt-md-0">
            Total Items: @(Model?.Count() ?? 0)
        </span>
    </div>

    <!-- Products Grid -->
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 border rounded bg-light my-4">
            <div class="text-muted mb-2" style="font-size: 2.5rem;">📦</div>
            <h5 class="fw-semibold text-secondary">No products currently available</h5>
            <p class="text-muted small mb-0">Please check back soon for our latest inventory updates.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        
                        <!-- Category Badge (if available) -->
                        @if (item.Category != null && !string.IsNullOrEmpty(item.Category.Category_Name))
                        {
                            <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 z-1">
                                @item.Category.Category_Name
                            </span>
                        }

                        <!-- Product Image -->
                        <div class="ratio ratio-4x3 bg-light rounded-top overflow-hidden">
                            @if (!string.IsNullOrEmpty(item.Product_Image))
                            {
                                <img src="@item.Product_Image" 
                                     class="card-img-top object-fit-cover" 
                                     alt="@item.Product_Name" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center text-muted">
                                    No Image Available
                                </div>
                            }
                        </div>

                        <!-- Product Details -->
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-bold text-truncate mb-1" title="@item.Product_Name">
                                @item.Product_Name
                            </h6>
                            <p class="text-muted small text-truncate mb-3">
                                @item.Product_Description
                            </p>
                            
                            <div class="mt-auto pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-dark fs-5">
                                        Rs. @item.Product_Price
                                    </span>
                                    <a asp-controller="Customer"
                                       asp-action="productDetails"
                                       asp-route-id="@item.product_id"
                                       class="text-decoration-none small text-muted">
                                        Details &rarr;
                                    </a>
                                </div>

                                <div class="mt-auto pt-2 border-top">
                                    <!-- Direct AJAX Add to Cart Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-dark w-100 d-flex align-items-center justify-content-center gap-2 cart-btn"
                                            data-prod-id="@item.product_id">
                                        <span class="btn-icon">🛒</span>
                                        <span class="btn-text">Add to Cart</span>
                                    </button>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

