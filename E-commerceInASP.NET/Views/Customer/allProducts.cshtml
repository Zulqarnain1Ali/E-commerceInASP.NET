@model IEnumerable<E_commerceInASP.NET.Models.Product>

@{
    ViewData["Title"] = "All Products - Store Catalogue";
}

<div class="container my-5">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Customer" asp-action="Index" class="text-decoration-none text-muted">Home</a>
            </li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Catalog</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h2 class="fw-bold mb-1">Our Complete Catalog</h2>
            <p class="text-muted small mb-0">Browse through all available products and collections.</p>
        </div>
        <span class="badge bg-dark px-3 py-2 fs-6 mt-2 mt-md-0">
            Total Items: @(Model?.Count() ?? 0)
        </span>
    </div>

    <!-- Products Grid -->
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 border rounded bg-light my-4">
            <div class="text-muted mb-2" style="font-size: 2.5rem;">📦</div>
            <h5 class="fw-semibold text-secondary">No products currently available</h5>
            <p class="text-muted small mb-0">Please check back soon for our latest inventory updates.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <partial name="_ProductCard" model="item" />
            }
        </div>
    }
</div>

