@model IEnumerable<E_commerceInASP.NET.Models.Cart>

@{
    ViewData["Title"] = "Checkout";

    decimal subtotal = 0;
    if (Model != null && Model.Any())
    {
        subtotal = Model.Sum(item =>
        {
            decimal price = 0;
            decimal.TryParse(item.products?.Product_Price?.ToString(), out price);
            return price * item.Product_Quantity;
        });
    }

    var customer = ViewBag.Customer as E_commerceInASP.NET.Models.Customer;
}

<div class="container my-5">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="viewCart" class="text-decoration-none text-muted">Cart</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Checkout</li>
        </ol>
    </nav>

    <div class="pb-3 mb-4 border-bottom">
        <h2 class="fw-bold mb-1">Checkout & Order Review</h2>
        <p class="text-muted small mb-0">Confirm your shipping details and review items before placing your order.</p>
    </div>

    <div class="row g-5">
        <!-- Billing / Shipping Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold mb-4">Shipping & Delivery Details</h5>

                <form asp-controller="Customer" asp-action="placeOrder" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input type="text" class="form-control" value="@customer?.Customer_Name" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" class="form-control" value="@customer?.Customer_Email" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contact Phone Number</label>
                        <input type="tel" name="contactNumber" class="form-control" placeholder="03XXXXXXXXX" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Delivery Address</label>
                        <textarea name="shippingAddress" rows="3" class="form-control" placeholder="House/Flat No., Street, Area, City" required></textarea>
                    </div>

                    <h5 class="fw-bold mb-3">Payment Method</h5>
                    <div class="form-check p-3 border rounded mb-4 bg-light">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="cod" checked>
                        <label class="form-check-label fw-semibold" for="cod">
                            Cash on Delivery (COD)
                        </label>
                        <div class="text-muted small">Pay securely in cash when your parcel arrives.</div>
                    </div>

                    <button type="submit" class="btn btn-dark btn-lg w-100 py-3 fw-bold">
                        Confirm & Place Order (Rs. @subtotal)
                    </button>
                </form>
            </div>
        </div>

        <!-- Order Summary Sidebar -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold mb-3">Items in Order (@Model.Sum(c => c.Product_Quantity))</h5>

                <div class="list-group list-group-flush mb-3">
                    @foreach (var item in Model)
                    {
                        decimal itemPrice = 0;
                        decimal.TryParse(item.products?.Product_Price?.ToString(), out itemPrice);

                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="ratio ratio-1x1 bg-light rounded overflow-hidden" style="width: 50px; height: 50px;">
                                    @if (!string.IsNullOrEmpty(item.products?.Product_Image))
                                    {
                                        <img src="@item.products.Product_Image" class="object-fit-cover" alt="@item.products.Product_Name" />
                                    }
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-semibold text-truncate" style="max-width: 180px;">
                                        @(item.products?.Product_Name ?? "Product")
                                    </h6>
                                    <small class="text-muted">Qty: @item.Product_Quantity &times; Rs. @itemPrice</small>
                                </div>
                            </div>
                            <span class="fw-bold text-dark">Rs. @(itemPrice * item.Product_Quantity)</span>
                        </div>
                    }
                </div>

                <div class="border-top pt-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-semibold">Rs. @subtotal</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Shipping</span>
                        <span class="text-success fw-semibold">Free</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-5 fw-bold">Total Payable</span>
                        <span class="fs-4 fw-bold text-dark">Rs. @subtotal</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>