@model IEnumerable<E_commerceInASP.NET.Models.Product>

@{
    ViewData["Title"] = "Storefront — Discover Modern Tech";
    var categories = ViewData["category"] as List<E_commerceInASP.NET.Models.Category>;
}

<style>
    :root {
        --surface-card: #ffffff;
        --surface-subtle: #f8fafc;
        --border-subtle: #e2e8f0;
        --text-headline: #0f172a;
        --text-body: #64748b;
        --accent-primary: #0f172a;
    }

    /* Minimal Hero */
    .hero-editorial {
        background: radial-gradient(circle at 80% 20%, #f1f5f9 0%, #fafafa 100%);
        border: 1px solid var(--border-subtle);
        border-radius: 24px;
    }

    /* Category Pill */
    .filter-chip {
        display: inline-block;
        padding: 0.45rem 1.15rem;
        border-radius: 9999px;
        background: #ffffff;
        border: 1px solid var(--border-subtle);
        color: var(--text-headline);
        font-weight: 500;
        font-size: 0.85rem;
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .filter-chip:hover, .filter-chip.active {
            background: var(--accent-primary);
            color: #ffffff;
            border-color: var(--accent-primary);
        }

    /* Product Cards */
    .store-card {
        background: #ffffff;
        border: 1px solid var(--border-subtle);
        border-radius: 20px;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        position: relative;
    }

        .store-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 32px -8px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

    .img-frame {
        height: 280px; /* Increased container height */
        background: #f8fafc;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        padding: 0.5rem; /* Optional breathing space */
    }

        .img-frame img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* Fills the container without cropping or distortion */
            transition: transform 0.3s ease;
        }

    .store-card:hover .img-frame img {
        transform: scale(1.05);
    }

    /* Value Proposition Strip */
    .value-box {
        border-left: 2px solid var(--border-subtle);
    }
    @@media (max-width: 767px) {
        .value-box {
            border-left: none;
            border-top: 2px solid var(--border-subtle);
        }
    }
</style>

<div class="container py-4">

    <!-- 1. HERO SECTION -->
    <section class="hero-editorial p-4 p-md-5 mb-5 position-relative overflow-hidden">
        <div class="row align-items-center g-4">
            <div class="col-lg-7 text-center text-lg-start">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill bg-white border small text-muted">
                    <span class="badge bg-dark rounded-pill">Catalog</span>
                    <span>Curated tech & hardware</span>
                </div>

                <h1 class="display-4 fw-bold tracking-tight text-dark mb-3" style="letter-spacing: -1.5px; line-height: 1.15;">
                    Clean essentials,<br />engineered for you.
                </h1>

                <p class="fs-6 text-muted mb-4 pe-lg-5">
                    Explore high-grade smartphones, accessories, and computing equipment with upfront pricing, certified inspection, and cash on delivery.
                </p>

                <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start">
                    <a href="#catalog" class="btn btn-dark px-4 py-2 rounded-pill fw-semibold">
                        Browse Devices
                    </a>
                    <a asp-controller="Customer" asp-action="Feedback" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                        Support & Desk
                    </a>
                </div>
            </div>

            <div class="col-lg-5 text-center d-none d-lg-block">
                <div class="p-4 rounded-4 bg-white shadow-sm border text-start mx-auto" style="max-width: 340px;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-light text-dark border px-2 py-1">Quick Metric</span>
                        <i class="bi bi-shield-check text-success fs-5"></i>
                    </div>
                    <h5 class="fw-bold mb-1">Direct Procurement</h5>
                    <p class="text-muted small mb-3">All listed hardware is stock-verified and ready for immediate courier handover.</p>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Dispatch SLA:</span>
                        <strong class="text-dark">24-48 Hours</strong>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. CATEGORY FILTER CHIPS -->
    @if (categories != null && categories.Any())
    {
        <div class="d-flex align-items-center gap-2 pb-3 mb-4 overflow-x-auto text-nowrap">
            <a asp-controller="Customer" asp-action="Index" class="filter-chip active">All Products</a>
            @foreach (var cat in categories)
            {
                <a asp-controller="Customer" asp-action="productDetails" asp-route-id="@cat.Category_id" class="filter-chip">
                    @cat.Category_Name
                </a>
            }
        </div>
    }

    <!-- 3. MAIN CATALOG GRID -->
    <section id="catalog" class="pb-5">
        <div class="d-flex justify-content-between align-items-baseline mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1" style="letter-spacing: -0.5px;">Products Available</h3>
                <span class="text-muted small">Showing latest additions to the store</span>
            </div>
            @* <span class="text-muted small fw-semibold">@(Model?.Count() ?? 0) Total Items</span> *@
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 border rounded-4 bg-light my-3">
                <i class="bi bi-box-seam display-5 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-dark">No records found</h5>
                <p class="text-muted small mb-0">Check back shortly or visit admin to stock inventory.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="store-card p-3 h-100 d-flex flex-column justify-content-between">

                            <!-- Frame & Image -->
                            <div class="img-frame mb-3">
                                @if (!string.IsNullOrEmpty(item.Product_Image))
                                {
                                    <img src="@item.Product_Image" alt="@item.Product_Name" loading="lazy" />
                                }
                                else
                                {
                                    <i class="bi bi-image text-muted display-6"></i>
                                }
                            </div>

                            <!-- Title & Pricing -->
                            <div class="flex-grow-1">
                                <span class="badge bg-light text-muted border small mb-1">In Stock</span>
                                <h6 class="fw-bold text-dark mb-1 text-truncate" title="@item.Product_Name">
                                    <a asp-controller="Customer" asp-action="productDetails" asp-route-id="@item.product_id" class="text-dark text-decoration-none">
                                        @item.Product_Name
                                    </a>
                                </h6>
                                <p class="text-muted small mb-0">Original Retail</p>
                            </div>

                            <!-- Footer / Action Row -->
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-3">
                                <div>
                                    <span class="fs-6 fw-bold text-dark">Rs. @item.Product_Price</span>
                                </div>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Customer" asp-action="productDetails" asp-route-id="@item.product_id"
                                       class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold text-secondary" title="Inspect details">
                                        View
                                    </a>
                                    <!-- Direct Add-to-Cart Trigger -->
                                    <button type="button" class="btn btn-sm btn-dark rounded-circle px-2 py-1" onclick="quickAddToCart(@item.product_id)" title="Add to Cart">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- 4. SUBTLE VALUE HIGHLIGHTS -->
    <section class="border rounded-4 bg-white p-4 p-md-5 my-4 shadow-sm">
        <div class="row g-4">
            <div class="col-md-4">
                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-truck me-2 text-primary"></i> Doorstep Courier</h6>
                <p class="text-muted small mb-0">Inspected packaging with verification available before payment handover.</p>
            </div>
            <div class="col-md-4 value-box ps-md-4">
                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-wallet2 me-2 text-primary"></i> Cash on Delivery</h6>
                <p class="text-muted small mb-0">No prepayment liability. Settle the order balance directly upon courier arrival.</p>
            </div>
            <div class="col-md-4 value-box ps-md-4">
                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-chat-heart me-2 text-primary"></i> Dedicated Support</h6>
                <p class="text-muted small mb-0">Direct access to dispute resolution and delivery status queries anytime.</p>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script>
        function quickAddToCart(productId) {
            $.ajax({
                url: '@Url.Action("addToCart", "Customer")',
                type: 'POST',
                data: { Prod_id: productId, quantity: 1 },
                success: function (res) {
                    if (res.redirectUrl) {
                        window.location.href = res.redirectUrl;
                    } else if (res.success) {
                        // Quick non-intrusive feedback
                        alert('Added to cart!');
                    }
                },
                error: function () {
                    alert('Could not add item. Please try again.');
                }
            });
        }
    </script>
}