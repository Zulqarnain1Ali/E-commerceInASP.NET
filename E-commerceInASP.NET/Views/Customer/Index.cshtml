@model IEnumerable<E_commerceInASP.NET.Models.Product>

@{
    ViewData["Title"] = "Mobile Store - Home";
}

<!-- Custom Inline Tweaks to match the Clean Tech UI -->
<style>
    .hero-section {
        background-color: #f7f9fc;
        border-radius: 20px;
    }

    .btn-brand-blue {
        background-color: #2563eb;
        border-color: #2563eb;
        color: #ffffff;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.2s ease-in-out;
    }

        .btn-brand-blue:hover {
            background-color: #1d4ed8;
            border-color: #1d4ed8;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }

    .product-card {
        border: 1px solid #edf2f7;
        border-radius: 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background-color: #ffffff;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        }

    .product-img-container {
        height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

        .product-img-container img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }
</style>

<div class="container my-4">

    <!-- HERO BANNER (Light tech background with hero devices) -->
    <section class="hero-section p-4 p-md-5 mb-5 overflow-hidden">
        <div class="row align-items-center g-4">
            <!-- Left Headline & Call to Action -->
            <div class="col-lg-6 py-lg-4 text-center text-lg-start">
                <span class="text-secondary small fw-semibold text-uppercase tracking-wide d-block mb-2">
                    Latest Smartphones
                </span>
                <h1 class="display-5 fw-bold text-dark lh-sm mb-3">
                    Find Your<br />Perfect Phone
                </h1>
                <p class="text-muted mb-4 fs-6">
                    Top brands. Best prices. Trusted store.
                </p>
                <div>
                    <a href="#popular-products" class="btn btn-brand-blue px-4 py-2">
                        Shop Now
                    </a>
                </div>
            </div>

            <!-- Right Showcase Devices -->
            <div class="col-lg-6 text-center">
                <img src="~/images/hero-phones.png"
                     alt="Smartphones Collection"
                     class="img-fluid"
                     style="max-height: 340px; object-fit: contain;"
                     onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1592750475338-74b7b21085ab?auto=format&fit=crop&w=700&q=80';" />
            </div>
        </div>
    </section>

    <!-- POPULAR PRODUCTS SECTION -->
    <section id="popular-products" class="pb-5">
        <!-- Section Header Row -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold text-dark mb-0">Popular Products</h4>
            <a asp-controller="Customer" asp-action="allProducts" class="text-decoration-none text-secondary small fw-semibold">
                View All &rarr;
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 border rounded-4 bg-white my-3">
                <div class="text-muted mb-2 fs-1">📱</div>
                <h6 class="fw-semibold text-secondary">No products available yet</h6>
                <p class="text-muted small mb-0">Check back later or add devices via the admin dashboard.</p>
            </div>
        }
        else
        {
            <!-- Product Grid (4 columns on desktop matching the mockup) -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var item in Model.Take(8))
                {
                    <div class="col">
                        <div class="card h-100 product-card p-3 d-flex flex-column justify-content-between">
                            <!-- Product Image Container -->
                            <div class="product-img-container mb-2">
                                @if (!string.IsNullOrEmpty(item.Product_Image))
                                {
                                    <img src="@item.Product_Image" alt="@item.Product_Name" />
                                }
                                else
                                {
                                    <div class="text-muted small text-center">
                                        <i class="bi bi-phone fs-1 d-block mb-1"></i>
                                        No Image
                                    </div>
                                }
                            </div>

                            <!-- Product Info -->
                            <div class="text-start mt-auto">
                                <h6 class="fw-bold text-dark text-truncate mb-1" title="@item.Product_Name">
                                    <a asp-controller="Customer" asp-action="productDetails" asp-route-id="@item.product_id" class="text-dark text-decoration-none">
                                        @item.Product_Name
                                    </a>
                                </h6>
                                <p class="text-muted fw-semibold small mb-3">
                                    Rs. @item.Product_Price
                                </p>

                                <!-- Add / View Details Action -->
                                <div class="d-grid">
                                    <a asp-controller="Customer" asp-action="productDetails" asp-route-id="@item.product_id" class="btn btn-outline-dark btn-sm rounded-2 py-1">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</div>