@model IEnumerable<E_commerceInASP.NET.Models.Product>

@{
    ViewData["Title"] = "Welcome to Our Store";
}

<!-- Hero Section -->
<div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
    <div class="container-fluid py-5 text-center">
        <h1 class="display-5 fw-bold text-dark">Discover Our Exclusive Collection</h1>
        <p class="col-md-8 fs-4 mx-auto text-muted">
            Browse our top-quality products handpicked just for you. Quality and reliability guaranteed.
        </p>
        <a href="#product-section" class="btn btn-warning btn-lg px-4 gap-3 fw-bold shadow-sm">Shop Now</a>
    </div>
</div>

<!-- Product Catalog Section -->
<div class="container my-5" id="product-section">
    <h2 class="text-center mb-4 fw-bold">Featured Products</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <!-- Product Image -->
                        @if (!string.IsNullOrEmpty(item.Product_Image))
                        {
                            <img src="@item.Product_Image" class="card-img-top" alt="Product Image" style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 220px;">
                                <span>No Image Available</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <!-- Category Badge -->
                            <div class="mb-2">
                                <span class="badge bg-secondary">
                                    @(item.Category != null ? item.Category.Category_Name : "General")
                                </span>
                            </div>

                            <!-- Title & Price -->
                            <h5 class="card-title fw-bold text-dark">@item.Product_Name</h5>
                            <h6 class="text-success fw-bold mb-3">$@item.Product_Price</h6>

                            <!-- Description Snippet -->
                            <p class="card-text text-muted small flex-grow-1">
                                @(item.Product_Description != null && item.Product_Description.Length > 80 
                                    ? item.Product_Description.Substring(0, 80) + "..." 
                                    : item.Product_Description)
                            </p>

                            <!-- Action Buttons -->
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <a asp-controller="Customer" asp-action="ProductDetails" asp-route-id="@item.product_id" class="btn btn-outline-dark btn-sm">View Details</a>
                                <button class="btn btn-warning btn-sm text-dark fw-bold">Add to Cart</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">No products are available right now. Please check back later!</p>
            </div>
        }
    </div>
</div>