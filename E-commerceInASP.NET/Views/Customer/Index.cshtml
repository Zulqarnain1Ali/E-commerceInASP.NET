@model IEnumerable<E_commerceInASP.NET.Models.Product>

@{
    ViewData["Title"] = "Home - Modern Store";
}

<!-- HERO BANNER -->
<section class="py-5 bg-dark text-white rounded-3 my-4 shadow-sm">
    <div class="container py-4 text-center text-lg-start">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-light text-dark text-uppercase px-3 py-2 fw-semibold mb-3">
                    New Season Arrivals
                </span>
                <h1 class="display-4 fw-bold lh-sm mb-3">
                    Elevate Your Lifestyle With Curated Essentials.
                </h1>
                <p class="lead text-white-50 mb-4">
                    Explore top-rated collections with unmatched quality, transparent pricing, and rapid delivery right to your door.
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <a href="#featured-products" class="btn btn-light btn-lg px-4 fw-semibold">
                        Shop Collection
                    </a>
                    <a asp-controller="Customer" asp-action="feedback" class="btn btn-outline-light btn-lg px-4">
                        Contact Support
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <div class="p-5 border border-secondary rounded-4 bg-black bg-opacity-25">
                    <h3 class="fw-bold mb-2">Exclusive Deals</h3>
                    <p class="text-white-50 mb-0">Handpicked items updated weekly.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- VALUE PROPOSITIONS -->
<section class="py-4 border-bottom mb-5">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="fs-2 text-dark">🚚</div>
                    <div class="text-start">
                        <h6 class="fw-bold mb-0">Fast & Reliable Delivery</h6>
                        <small class="text-muted">Swift dispatch straight to your location.</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="fs-2 text-dark">🛡️</div>
                    <div class="text-start">
                        <h6 class="fw-bold mb-0">Verified Quality</h6>
                        <small class="text-muted">100% authentic and vetted products.</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="fs-2 text-dark">💬</div>
                    <div class="text-start">
                        <h6 class="fw-bold mb-0">Dedicated Support</h6>
                        <small class="text-muted">Our care team is always here to assist.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURED PRODUCTS SECTION -->
<section id="featured-products" class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-uppercase text-muted fw-bold small">Catalog</span>
                <h2 class="fw-bold mb-0">Featured Products</h2>
            </div>
            <span class="badge bg-secondary px-3 py-2">
                @(Model?.Count() ?? 0) Items Available
            </span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 border rounded bg-light">
                <div class="text-muted mb-2" style="font-size: 2.5rem;">📦</div>
                <h5 class="fw-semibold text-secondary">No products in the store yet</h5>
                <p class="text-muted small mb-0">Add products through the Admin panel to display them here.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <partial name="_ProductCard" model="item" />
                }
            </div>
        }
        
<div class="text-center mt-5">
    <a asp-controller="Customer" asp-action="allProducts" class="btn btn-outline-dark btn-lg px-5 py-2 fw-semibold">
        Explore All Products &rarr;
    </a>
</div>
    </div>
</section>

<!-- CALL TO ACTION / BANNER -->
<section class="container my-5">
    <div class="card border-0 bg-light p-4 p-md-5 text-center rounded-3">
        <h3 class="fw-bold mb-2">Have questions about our catalogue?</h3>
        <p class="text-muted mb-4 mx-auto" style="max-width: 600px;">
            Reach out via our customer feedback page or check our location details.
        </p>
        <div>
            <a asp-controller="Customer" asp-action="feedback" class="btn btn-dark px-4 py-2">
                Leave a Note / Message
            </a>
        </div>
    </div>
</section>