@{
    ViewData["Title"] = "Order Placed Successfully";
}

<div class="container my-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-light">
                <div class="mb-3 text-success" style="font-size: 4rem; line-height: 1;">
                    ✓
                </div>
                <h2 class="fw-bold text-dark mb-2">Thank You for Your Order!</h2>
                <p class="text-secondary mb-4">
                    Your order has been placed successfully and has been routed to our admin team. It will be verified and dispatched shortly.
                </p>

                <div class="alert alert-secondary border-0 small text-muted mb-4 py-3">
                    Payment Method: <strong>Cash on Delivery (COD)</strong><br />
                    Please keep the exact amount ready upon delivery.
                </div>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-controller="Customer" asp-action="allProducts" class="btn btn-dark btn-lg px-4">
                        Continue Shopping
                    </a>
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>