@model E_commerceInASP.NET.Models.Product
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Add New Product</h4>
                </div>
                <div class="card-body">
                    <form asp-action="addProduct" method="post" enctype="multipart/form-data">
                        
                        <div class="mb-3">
                            <label asp-for="Product_Name" class="form-label font-weight-bold">Product Name</label>
                            <input asp-for="Product_Name" class="form-control" placeholder="Enter product name..." required />
                            <span asp-validation-for="Product_Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Product_Price" class="form-label font-weight-bold">Price</label>
                            <input asp-for="Product_Price" class="form-control" placeholder="Enter price..." required />
                            <span asp-validation-for="Product_Price" class="text-danger"></span>
                        </div>

                      @*  <div class="mb-3">
                            <label asp-for="Category_id" class="form-label font-weight-bold">Category</label>
                            <!-- Dropdown populated from ViewBag.Categories -->
                            <select asp-for="Category_id" class="form-select" asp-items="ViewBag.Categories" required>
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="Category_id" class="text-danger"></span>
                        </div> *@

                        @Html.Partial("_CategoryDropdown", ViewData["category"]) 

                        <div class="mb-3">
                           <label class="form-label font-weight-bold">Product Image File</label>
                           <input type="file" name="file" class="form-control" />
                           <span asp-validation-for="Product_Image" class="text-danger"></span>
                       </div>

                        <div class="mb-3">
                            <label asp-for="Product_Description" class="form-label font-weight-bold">Description</label>
                            <textarea asp-for="Product_Description" class="form-control" rows="3" placeholder="Enter description..."></textarea>
                            <span asp-validation-for="Product_Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="fetchProducts" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-success">Save Product</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>