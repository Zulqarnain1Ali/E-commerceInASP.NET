@model E_commerceInASP.NET.Models.Admin
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h1> My Profile </h1>


<br /> 
<br /> 



<form method="post" asp-action="Profile" enctype="multipart/form-data">
    <input type="hidden" asp-for="admin_id" />

    <div class="mb-3">
        <label class="form-label">Admin Name</label>
        <input asp-for="admin_name" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email Address</label>
        <input asp-for="admin_email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">New Password (Optional)</label>
        <input asp-for="admin_password" type="password" class="form-control" placeholder="Leave blank to keep current password" />
    </div>

    <div class="mb-3">
        <label class="form-label">Profile Picture</label>
        <input type="file" name="file" class="form-control" />
    </div>


    @if (!string.IsNullOrEmpty(Model.admin_image))
    {
        <div class="mb-3">
            <label class="form-label">Current Picture</label><br />
            <img src="@Model.admin_image" width="80" height="80" class="rounded-circle" alt="Profile Picture" />
        </div>
    }

    <button type="submit" class="btn btn-primary">Save Changes</button>

</form>




