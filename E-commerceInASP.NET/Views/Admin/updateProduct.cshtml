@model E_commerceInASP.NET.Models.Product

@{
    ViewData["Title"] = "Update Product";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Update Product</h4>
                </div>
                <div class="card-body">
                    <form asp-action="updateProduct" method="post" enctype="multipart/form-data">
                        
                        <input type="hidden" asp-for="product_id" />
                        
                        <div class="mb-3">
                            <label asp-for="Product_Name" class="form-label font-weight-bold">Product Name</label>
                            <input asp-for="Product_Name" class="form-control" placeholder="Enter product name..." required />
                            <span asp-validation-for="Product_Name" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Product_Price" class="form-label font-weight-bold">Product Price</label>
                            <input asp-for="Product_Price" class="form-control" placeholder="Enter product price..." required />
                            <span asp-validation-for="Product_Price" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                        <label class="form-label font-weight-bold">Product Category</label>
                        @Html.Partial("_CategoryDropdown", ViewData["category"]) 
                        </div>
                        <div class="mb-3">
                            <label asp-for="Product_Description" class="form-label font-weight-bold">Product Description</label>
                            <textarea asp-for="Product_Description" class="form-control" placeholder="Enter product Description..." required ></textarea>
                            <span asp-validation-for="Product_Description" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Update Product Image</label>
                            <input type="file" name="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="Product_Image" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="fetchProducts" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-warning">Update Product</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>